# ============================================================
# ONEBOOK - ตัวแปรสภาพแวดล้อม (คัดลอกไฟล์นี้เป็น .env.local)
# ============================================================

# --- Supabase (จำเป็น) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- ควบคุมการเข้าถึงจากภายนอก ---
# รายการ IP / CIDR ที่อนุญาต คั่นด้วยจุลภาค เว้นว่าง = อนุญาตทุก IP (ไม่แนะนำ)
# ตัวอย่าง: 203.0.113.10,203.0.113.0/24,10.0.0.0/8
ALLOWED_IPS=
# บังคับตรวจ IP แม้อยู่ในโหมด development (true/false)
ENFORCE_IP_ALLOWLIST=true
# โดเมนที่อนุญาตให้เรียก server action (ป้องกัน CSRF ข้ามโดเมน)
APP_ORIGIN=https://accounting.internal.example.com

# --- นโยบายเซสชัน ---
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- ข้อมูลองค์กร (ใช้ตอน seed ครั้งแรก) ---
NEXT_PUBLIC_APP_NAME=ONEBOOK
NEXT_PUBLIC_DEFAULT_LOCALE=th

# --- e-Tax Invoice (ต้องมีใบรับรองจาก CA + ผู้ให้บริการที่ ETDA รับรอง) ---
ETAX_PROVIDER=
ETAX_API_URL=
ETAX_API_KEY=
ETAX_CERT_ID=

# --- บริการอ่านเอกสารด้วย OCR/AI (AICOM) ---
# รัน AICOM แยกต่างหาก : https://github.com/tiwpheerachan/AICOM (docker compose up)
# ฝั่ง AICOM ต้องตั้ง OPENAI_API_KEY เอง
AICOM_API_URL=
AICOM_API_KEY=

# --- ผู้ช่วย AI สรุปงาน (ไม่บังคับ) ---
# ถ้าไม่ตั้งค่า ระบบจะสรุปงานด้วยกฎที่เขียนไว้ ซึ่งใช้งานได้ตามปกติ
# รองรับทั้ง Anthropic (Claude) และ endpoint แบบ OpenAI
#
#   Claude  : AI_API_URL=https://api.anthropic.com/v1
#             AI_MODEL=claude-haiku-4-5-20251001   (ประหยัด)
#             AI_MODEL=claude-sonnet-5             (ภาษาไทยดีกว่า)
#             คีย์จาก console.anthropic.com -> API keys (ขึ้นต้น sk-ant-)
#
#   OpenAI  : AI_API_URL=https://api.openai.com/v1
#             AI_MODEL=gpt-4o-mini
#
# ระบบแยกให้เองจาก URL ไม่ต้องตั้งค่าอย่างอื่นเพิ่ม
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# --- เข้าสู่ระบบด้วย GoodHR (SSO) ---
# ตั้งครบทั้ง 3 ตัวเมื่อไร ปุ่ม "เข้าสู่ระบบด้วย GoodHR" จะโผล่ขึ้นมาเอง
# และระบบจะปิดการล็อกอินด้วยรหัสผ่านโดยอัตโนมัติ
# ชื่อตัวแปรตามที่ GoodHR กำหนดมาในเอกสาร
GOODHR_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# ต้องตรงเป๊ะกับที่ลงทะเบียนไว้กับ GoodHR
OAUTH_REDIRECT_URI=https://<โดเมนจริง>/api/auth/callback/goodhr

# scope ที่ขอ (ค่าเริ่มต้นเพียงพอแล้ว)
GOODHR_SCOPE=openid profile email employee

# เชื่อ app_role ที่ผู้ดูแล GoodHR กำหนดมาหรือไม่
#   false (ค่าเริ่มต้น) = ผู้ดูแล ONEBOOK ต้องอนุญาตรายคนเอง — คุมสิทธิ์ได้ละเอียดกว่า
#   true               = ใครที่ GoodHR อนุญาตและมี app_role จะเข้าได้เลย
#                        โดยจับคู่บริษัทจากชื่อใน claim company_name
GOODHR_TRUST_APP_ROLE=false

# ทางเข้าสำรองด้วยอีเมล/รหัสผ่าน เผื่อ GoodHR ใช้งานไม่ได้
# แนะนำให้เปิดไว้ช่วงแรก แล้วปิดเมื่อ SSO นิ่งแล้ว
ALLOW_PASSWORD_LOGIN=true
